# LLM provider - set ONE of these. Model is swappable: one line, no code change.
OPENAI_API_KEY=sk-...
MODEL=gpt-5.4-mini

# Alternatives (uncomment to use instead; same code, different model):
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=anthropic/claude-haiku-4-5
# GEMINI_API_KEY=...
# MODEL=gemini/gemini-flash-latest

# Web search (serper.dev free tier)
SERPER_API_KEY=
